{
  "name": "steel-dms-storage-agent",
  "version": "1.0.0",
  "description": "Secure file storage agent for Steel DMS — runs on the Windows server to serve files from E:\\Storage via API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "generate-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "install-service": "node install-service.js",
    "uninstall-service": "node uninstall-service.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-windows": "^1.0.0-beta.8"
  }
}
