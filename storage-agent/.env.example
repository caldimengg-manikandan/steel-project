# ============================================================
# Steel DMS Storage Agent — Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# 
# IMPORTANT: Never commit .env to version control!
# ============================================================

# Port the agent listens on (Cloudflare Tunnel connects to this)
PORT=4500

# Root directory on the Windows server where project files are stored.
# The agent can ONLY access files under this path.
# Example: E:\Storage  or  D:\SteelProjects
STORAGE_ROOT=E:\Storage

# Shared secret key for authenticating requests from the cloud app.
# Generate one by running: npm run generate-key
# Then copy the SAME key to your cloud app's .env as STORAGE_AGENT_API_KEY
API_KEY=CHANGE_ME_run_npm_run_generate-key

# (Optional) Comma-separated list of allowed IP addresses.
# Only these IPs can connect. Leave empty to allow all (rely on API key + Cloudflare Tunnel).
# Example: 13.234.56.78,52.66.123.45
ALLOWED_IPS=

# (Optional) Restrict to read-only mode. Set to true to disable uploads and deletes.
READ_ONLY=false

# (Optional) Comma-separated list of blocked file extensions (case-insensitive).
# These file types can never be downloaded or uploaded.
BLOCKED_EXTENSIONS=.exe,.bat,.cmd,.ps1,.vbs,.msi,.dll,.sys,.com,.scr

# (Optional) Allowed origin for CORS. Set to your cloud app URL.
# Example: https://steel-dms-frontend.onrender.com
CORS_ORIGIN=*

# (Optional) Maximum upload file size in MB.
MAX_UPLOAD_MB=500